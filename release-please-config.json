{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore(release): publish v${version} \u2014 review and merge to ship to PyPI",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "lost_sessions",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.source && @.source.editable && @.source.editable.value=='.')].version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "refactor",
          "section": "Refactor"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "chore",
          "scope": "deps",
          "section": "Dependencies"
        },
        {
          "type": "chore",
          "scope": "deps-dev",
          "section": "Dependencies"
        },
        {
          "type": "build",
          "scope": "deps",
          "section": "Dependencies"
        },
        {
          "type": "build",
          "scope": "deps-dev",
          "section": "Dependencies"
        },
        {
          "type": "chore",
          "section": "Miscellaneous",
          "hidden": true
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Styles",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "build",
          "section": "Build System",
          "hidden": true
        }
      ]
    }
  }
}
