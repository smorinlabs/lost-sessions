def load_rows(since):
    """(boot, start, rows). Exits 2 on a bad --since and 1 when the inventory gives nothing usable."""
    si = find_inventory()
    if not si:
        error("session-inventory not found; install the session-agent-list skill")
        sys.exit(1)
    boot = boot_time()
    try:
        start = parse_since(since, boot)
    except ValueError:
        error(f"--since {since!r}: use a date (2026-11-09), a date-time, or <n>m|h|d|w (e.g. 3d)")
        sys.exit(2)
    proc = subprocess.run([si, "list", "--json", "--since", start.isoformat(timespec="seconds")],
                          capture_output=True, text=True, check=False)
    try:
        inv = json.loads(proc.stdout)
    except ValueError:
        inv = None
    if proc.returncode not in (0, 1) or not isinstance(inv, dict):
        error(f"session-inventory failed (exit {proc.returncode}): {proc.stderr.strip()}")
        sys.exit(1)
    if proc.returncode == 1:  # partial failure: one store unreadable, the others still listed
        for line in proc.stderr.strip().splitlines():
            warn(f"session-inventory: {line}")
        warn("some sessions may be missing from this list")
    herdr = herdr_index(Path.home() / ".config" / "herdr", boot)
    rows = select_rows(inv.get("sessions", []), boot, start)
    for s in rows:
        s["herdr"] = herdr.get(s["id"])
    return boot, start, rows


def visible(rows, args, show_all=None):
    show_all = args.all if show_all is None else show_all
    def keep(s):
        if not args.include_helpers and is_helper(s):
            return False
        return show_all or not hidden_by_default(s)
    return [s for s in rows if keep(s)]


def cmd_list(args):
    boot, start, rows = load_rows(args.since)
    shown = visible(rows, args)
    shorts = short_ids(rows)
    lost = [s for s in rows if not s["herdr"] and not is_helper(s) and s.get("live") != "yes"]
    print(f"Boot: {boot:%a %b %d %H:%M}   sessions started before it and active since {start:%a %b %d %H:%M}")
    print(f"{len(rows)} sessions; {len(lost)} lost (not in Herdr, not running, not helper runs)\n")
    for s in shown:
        state = state_label(s) or "closed"
        where = f"IN HERDR: {s['herdr']}" if s["herdr"] else "not in Herdr"
        print(f"[{s['n']:>2}] {shorts[s['id']]}  {s['tool']:<8} {where}  |  {state}  |  "
              f"started {_parse(s['created']).astimezone():%b %d}  "
              f"last active {_parse(s['updated']).astimezone():%b %d %H:%M}")
        print(f"     about: {about(s)}")
        print(f"     id:    {s['id']}")
        print(f"     dir:   {s.get('spawn_dir')}")
        print(f"     open:  {resume_command(s)}\n")
    save_listing(shown, start)
    return 0


def resolve_refs(refs, rows, listing):
    """Map each REF (a number from the saved listing, or a full or unique-prefix session ID) to a row."""
    by_id = {s["id"]: s for s in rows}
    picked, problems = [], []
    for ref in refs:
        if re.fullmatch(r"\d{1,4}", ref):
            if not listing:
                problems.append(f"#{ref}: no saved listing; run `lost-sessions list` first, or use a session ID")
                continue
            hit = next((r for r in listing["rows"] if r.get("n") == int(ref)), None)
            if not hit:
                problems.append(f"#{ref} is not in the last listing")
            elif hit["id"] not in by_id:
                problems.append(f"#{ref} ({hit['id']}) is no longer in the window")
            else:
                picked.append(by_id[hit["id"]])
            continue
        matches = [s for s in rows if s["id"].startswith(ref)]
        if len(matches) == 1:
            picked.append(matches[0])
        elif not matches:
            problems.append(f"{ref}: no session ID starts with this")
        else:
            problems.append(f"{ref} matches {len(matches)} sessions: " + ", ".join(s["id"] for s in matches[:5]))
    return picked, problems


def cmd_open(args):
    action = "print" if args.print else ("rex" if args.rex else "herdr")
    split = [r.partition("@") for r in args.refs]  # 29@codex: session 29 into the `codex` workspace or session
    refs, wanted = [ref for ref, _, _ in split], [dest if at else None for _, at, dest in split]
    if action == "print" and any(w is not None for w in wanted):
        error("REF@DEST names a Herdr workspace or Rex session; it does not apply to --print")
        return 2
    if any(w == "" for w in wanted):
        error("REF@ needs a destination after the @, e.g. 29@recovered")
        return 2
    if args.focus is not None and action == "print":
        error("--focus brings an opened session to the front; it does not apply to --print")
        return 2
    if args.focus not in (None, LAST) and args.focus not in refs:
        error(f"--focus {args.focus}: name one of the REFs being opened ({', '.join(refs)})")
        return 2
    listing = load_listing()
    numeric = any(re.fullmatch(r"\d{1,4}", r) for r in refs)
    since = args.since if args.since or not (numeric and listing) else listing.get("since")
    _, _, rows = load_rows(since)
    picked, problems = resolve_refs(refs, rows, listing)
    if action == "rex" and CURRENT in [args.rex_session, *wanted] and not os.environ.get("REX_SESSION"):
        warn("not running inside Rex: `current` opens in the session the Rex app is showing")
    for p in problems:
        error(p)
    if problems:
        return 2
    if numeric and listing:
        saved = _parse(listing.get("saved"))
        if saved and dt.datetime.now().astimezone() - saved > LISTING_MAX_AGE:
            warn(f"numbers come from a listing saved {saved:%b %d %H:%M}; run `lost-sessions list` to refresh")
    dests = load_destinations(args.workspace, args.rex_session, args.herdr_session) if action != "print" else None
    if dests:
        for label in dict.fromkeys(w or dests.defaults[action] for w in wanted):
            ids = dests.ambiguous(action, label)
            if ids:
                error(f"{label!r} names {len(ids)} {'workspaces' if action == 'herdr' else 'sessions'} "
                      f"({', '.join(ids)}); use the ID instead, e.g. REF@{ids[0]}")
                return 2
    entries = []
    for s, dest in zip(picked, wanted, strict=True):
        target = (dests.get(action, dest) if dest else dests.default(action)) if dests else None
        info(f"#{s['n']} → {s['id']}  {about(s)}" + (f"  → {dests.describe(target)}" if target else ""))
        entries.append(run_action(s, action, target))
    if args.focus is not None and entries:
        opened = [e for e in entries if focus_command(e, args.herdr_session)]
        pick = (opened[-1] if opened else entries[-1]) if args.focus == LAST else entries[refs.index(args.focus)]
        run_focus(pick, args.herdr_session)
    return exit_status(entries)


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


def cmd_recover(args):
    if not interactive():
        error("lost-sessions recover needs a terminal; without one use "
              "`lost-sessions open REF --print|--rex|--herdr`")
        return 2
    _, start, rows = load_rows(args.since)
    candidates = visible(rows, args, show_all=True)  # `a` in the menu shows or hides the running ones
    if not visible(rows, args):
        hidden = len(candidates)
        info("No lost sessions in this window" + (f" ({hidden} running or in Herdr; --all shows them)." if hidden
                                                  else " (try --since)."))
        return 0
    save_listing(candidates, start)
    _, herdr_ok = herdr_workspaces(args.herdr_session)
    dests = load_destinations(args.workspace, args.rex_session, args.herdr_session)
    menu = make_menu(candidates, dests, herdr_ok, args.all)
    chosen = menu.run() or []
    if not chosen:
        info("Nothing chosen; nothing done.")
        return 0
    # Re-check liveness: a session may have been resumed elsewhere while the menu was open.
    _, _, fresh = load_rows(start.isoformat(timespec="seconds"))
    live_now = {s["id"]: s.get("live") for s in fresh}
    entries = []
    for s, action, target in chosen:
        if action != "print" and live_now.get(s["id"]) == "yes":
            s["live"] = "yes"
        entries.append(run_action(s, action, target))
    marked = [e for e in entries if e["id"] == menu.focus_id]  # focus last, so it ends up in front
    if marked:
        run_focus(marked[0], args.herdr_session)
    return exit_status(entries)


def cmd_workspaces(args):
    """Where sessions can open: Herdr workspaces, then Rex sessions. The first of each is the default."""
    _, herdr_ok = herdr_workspaces(args.herdr_session)
    _, rex_ok = rex_sessions()
    dests = load_destinations(args.workspace, args.rex_session, args.herdr_session)
    tabs = {w.get("workspace_id"): w.get("tab_count", 0) for w in dests.workspaces}
    print("Herdr workspaces (--workspace, or REF@LABEL with --herdr):")
    if herdr_ok:
        for i, t in enumerate(dests.choices("herdr")):
            extra = f"{t.workspace_id:<6} {tabs.get(t.workspace_id, 0)} tabs" if t.workspace_id else \
                "created on first use"
            print(f"  {dests.describe(t):<40} {extra}" + ("   (default)" if i == 0 else ""))
    else:
        error("could not reach Herdr (`herdr workspace list` failed)")
    print("\nRex sessions (--rex-session, or REF@LABEL with --rex; `current` is this session):")
    if rex_ok:
        for i, t in enumerate(dests.choices("rex")):
            extra = t.session_id or ("Rex's active session" if t.current else "created on first use")
            print(f"  {dests.describe(t):<40} {extra}" + ("   (default)" if i == 0 else ""))
    else:
        error("could not reach Rex (`rex session list` failed)")
    return 0 if herdr_ok and rex_ok else 1


def cmd_history(args):
    print(f"Log: {log_path()}", file=sys.stderr if args.json else sys.stdout)
    entries = read_log()
    if args.json:
        for e in entries:
            print(json.dumps(e))
    elif not entries:
        print("No recoveries logged yet.")
    else:
        print()
        print("\n\n".join(format_entry(e) for e in entries))
    return 0


def build_parser():
    window = argparse.ArgumentParser(add_help=False)
    window.add_argument("--since", metavar="WHEN",
                        help="start of the window: a date, a date-time, or <n>m|h|d|w (default: 00:00 on the day "
                             "before the last boot). Sessions must have started before the boot")
    shown = window.add_mutually_exclusive_group()
    shown.add_argument("--all", action="store_true", default=False,
                       help="also show running and Herdr-tracked sessions (Print only); `a` toggles this in the menu")
    shown.add_argument("--hide-running", dest="all", action="store_false", default=False,
                       help="hide running and Herdr-tracked sessions (the default)")
    window.add_argument("--include-helpers", action="store_true",
                        help="also show helper runs (scratchpad folders, Codex Companion tasks)")
    herdr = argparse.ArgumentParser(add_help=False)
    herdr.add_argument("--workspace", default="recovered", metavar="LABEL",
                       help="default Herdr workspace (default: recovered, created if missing)")
    herdr.add_argument("--rex-session", default="recovered", metavar="LABEL",
                       help="default Rex session (default: recovered, created if missing; `current` is the "
                            "session you run this in)")
    herdr.add_argument("--herdr-session", metavar="NAME", help="a named Herdr session instead of the default one")

    p = argparse.ArgumentParser(prog="lost-sessions", description=(
        "Recover Claude Code, Codex, Muse and OpenCode sessions that started before the last boot "
        "but that Herdr will not restore."), epilog=f"History log: {log_path()}")
    sub = p.add_subparsers(dest="command", metavar="COMMAND")
    sub.add_parser("recover", parents=[window, herdr],
                   help="interactive menu: choose Print, Rex or Herdr for each lost session").set_defaults(func=cmd_recover)
    sub.add_parser("list", parents=[window], help="numbered list of lost sessions").set_defaults(func=cmd_list)
    o = sub.add_parser("open", parents=[window, herdr], help="print or open sessions without the menu",
                       description="REF is a number from the last `list` or `recover`, or a full or unique-prefix "
                                   "session ID. REF@DEST opens that session in the Herdr workspace or Rex session "
                                   "named DEST instead of the default, e.g. 29@codex 31@'tax prep'.")
    o.add_argument("refs", nargs="+", metavar="REF")
    how = o.add_mutually_exclusive_group(required=True)
    how.add_argument("--print", action="store_true", help="print the resume command")
    how.add_argument("--rex", action="store_true", help="open in a new window in a Rex session")
    how.add_argument("--herdr", action="store_true", help="open in a Herdr workspace")
    o.add_argument("--focus", nargs="?", const=LAST, metavar="REF",
                   help="afterwards, bring REF (default: the last one opened) to the front in Rex or Herdr")
    o.set_defaults(func=cmd_open)
    sub.add_parser("workspaces", parents=[herdr],
                   help="list the Herdr workspaces and Rex sessions you can open sessions in"
                   ).set_defaults(func=cmd_workspaces)
    h = sub.add_parser("history", help="show where the log is, then every logged action")
    h.add_argument("--json", action="store_true", help="print the raw JSON lines (the log location goes to stderr)")
    h.set_defaults(func=cmd_history)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
