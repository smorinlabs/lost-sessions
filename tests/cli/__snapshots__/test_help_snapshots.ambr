# name: test_help_snapshot[lost_sessions projects]
  '''
  Usage: lost_sessions projects [OPTIONS] COMMAND [ARGS]...
  
    List and inspect Py projects.
  
  Options:
    -h, --help  Show this message and exit.
  
  Commands:
    get   Fetch a single project by its ID.
    list  List projects, optionally filtered by workspace.
  
  '''
# ---
# name: test_help_snapshot[lost_sessions]
  '''
  Usage: lost_sessions [OPTIONS] COMMAND [ARGS]...
  
    lost_sessions — a gh-style CLI for Py.
  
    Commands follow a noun-verb shape, e.g. `lost_sessions projects list`. Every
    command supports -o/--output {text,json,markdown}, --json, -v/--verbose, --no-
    color, and --config. Results go to stdout; logs and errors go to stderr.
  
  Options:
    -V, --version  Show version, Python, and platform, then exit.
    -h, --help     Show this message and exit.
  
  Commands:
    completion  Print a shell completion script.
    config      Inspect and edit CLI configuration.
    doctor      Diagnose configuration and environment.
    projects    List and inspect Py projects.
  
  '''
# ---
